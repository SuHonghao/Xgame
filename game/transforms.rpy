transform portrait_left:
    xalign 0.05
    yalign 1.0

transform portrait_right:
    xalign 0.95
    yalign 1.0

transform left:
    xalign 0.05
    yalign 1.0

transform right:
    xalign 0.95
    yalign 1.0

transform center:
    xalign 0.5
    yalign 1.0

transform lower_left:
    crop_relative True
    crop (0.0, 0.0, 1.0, 0.60)
    xsize 400
    fit "contain"
    xalign 0.0
    xoffset -80
    yalign 1.0